{
  "expo": {
    "name": "anishie(DEV)",
    "slug": "anishie",
    "version": "0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.jpg",
    "scheme": "anishie",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icon.jpg",
        "backgroundImage": "./assets/icon.jpg",
        "monochromeImage": "./assets/icon.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kenshie.anishie"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090A12",
          "image": "./assets/icon.jpg",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "da9ae471-dd10-4227-ae2b-51fe18fe99ce"
      }
    }
  }
}
